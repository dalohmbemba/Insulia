    <!-- Instructions -->
    <string name="page_instructions">Instruction Section</string>
    <string name="instructions_intro">Guidance for patients and caregivers</string>
    <string name="instructions_glucose_title">Glucose monitoring</string>
    <string name="instructions_glucose_body">Check and record glucose readings as instructed by your healthcare professional. Bring your records to clinic visits.</string>
    <string name="instructions_medication_title">Taking medication</string>
    <string name="instructions_medication_body">Take medication exactly as prescribed. Do not change the dose or stop treatment without speaking to your healthcare professional.</string>
    <string name="instructions_food_title">Food and meals</string>
    <string name="instructions_food_body">Try to eat regular, balanced meals and follow the dietary advice provided by your clinic. Individual needs can differ.</string>
    <string name="instructions_foot_title">Foot and wound care</string>
    <string name="instructions_foot_body">Check your feet regularly. If you notice a wound, swelling, redness or signs of infection, contact your clinic promptly and follow their wound-care instructions.</string>
    <string name="instructions_appointments_title">Clinic appointments</string>
    <string name="instructions_appointments_body">Attend scheduled visits. If you miss an appointment, contact the clinic to ask how to arrange another date.</string>
    <string name="instructions_help_title">When to seek help</string>
    <string name="instructions_help_body">Seek urgent medical help if you feel seriously unwell or have severe symptoms. Follow the emergency advice given by your healthcare team.</string>
    <string name="instructions_disclaimer">General educational examples only. Always follow instructions from your healthcare professional.</string>

