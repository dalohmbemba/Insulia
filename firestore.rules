rules_version = '2';

// Insulia stores all patient data under /users/{uid} and keeps a small
// uniqueness index under /patientIds/{patientId}.
//
// A patient may only read and write documents inside their own user tree.
// Patient IDs are generated by the Android app but they are only accepted when
// the matching reservation and profile state agree after the write (getAfter).
// Once an ID is assigned it cannot be changed or deleted, and reservations
// cannot be overwritten.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPatientId(value) {
      return value is string && value.matches('^INS-[A-HJ-NP-Z2-9]{8}$');
    }

    // getAfter() sees writes from the same transaction, so the reservation and
    // the profile update protect each other atomically.
    function hasOwnedReservationAfter(patientId) {
      let reservation = /databases/$(database)/documents/patientIds/$(patientId);
      return existsAfter(reservation)
        ? getAfter(reservation).data.uid == request.auth.uid
        : false;
    }

    function profilePatientIdAfter(userId) {
      let profile = /databases/$(database)/documents/users/$(userId);
      return existsAfter(profile)
        ? getAfter(profile).data.get('patientId', '')
        : '';
    }

    // Profile document: /users/{uid}
    match /users/{userId} {
      allow read: if isOwner(userId);

      // A new profile may be saved without an ID (for example while offline).
      // A non-empty ID is only accepted when it has a reservation owned by this
      // patient after the write.
      allow create: if isOwner(userId)
        && (
          request.resource.data.get('patientId', '') == ''
          || (
            isValidPatientId(request.resource.data.get('patientId', ''))
            && hasOwnedReservationAfter(request.resource.data.get('patientId', ''))
          )
        );

      // Existing profile fields can be edited, but an assigned Patient ID must
      // stay exactly the same. The only exception is the first assignment to a
      // blank profile, which must have an owned reservation after the write.
      allow update: if isOwner(userId)
        && (
          request.resource.data.get('patientId', '') == resource.data.get('patientId', '')
          || (
            resource.data.get('patientId', '') == ''
            && isValidPatientId(request.resource.data.get('patientId', ''))
            && hasOwnedReservationAfter(request.resource.data.get('patientId', ''))
          )
        );

      // Deleting the profile would let a client rotate the permanent Patient
      // ID. Account erasure, if added later, must use a trusted server process.
      allow delete: if false;
    }

    // Readings, food notes, appointments, medications and notifications.
    // The explicit {collection} segment keeps this match from also granting
    // delete access to the profile document itself.
    match /users/{userId}/{collection}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Uniqueness index for Patient IDs. A create is the atomic reservation:
    // the document id is the Patient ID, so it cannot exist twice. The
    // reservation is only accepted when the caller's profile has the same ID
    // after the transaction, which prevents a patient from reserving arbitrary
    // values. Updates and deletes are forbidden, so a reservation is permanent.
    match /patientIds/{patientId} {
      // The allocation transaction must be able to read a candidate, even when
      // it belongs to another patient, to detect a collision and try again.
      // Individual reads are allowed, listing is not, and these documents hold
      // no clinical data.
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && isValidPatientId(patientId)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && profilePatientIdAfter(request.auth.uid) == patientId;

      allow update, delete: if false;
    }

    // Deny everything that is not part of a patient's own tree or the ID index.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
